{
  "manifest_version": 3,
  "name": "Mark Feed Links as Read",
  "version": "0.0.0",
  "description": "Marks loaded New Scientist article tabs as seen and decorates matching links on newscientist.com.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "*://newscientist.com/*",
    "*://www.newscientist.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://newscientist.com/*",
        "*://www.newscientist.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
